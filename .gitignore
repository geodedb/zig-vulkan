# Temporary and log files
*cweb.log
*.tmp
*.tar.gz
*.tar.xz

# Root-level generated directories and files
/core
core
/external/
/dist/
/out/
/results
/.mcp.json
/.geode_embedded/
/data/
/data_embedded/
/data_*/
tests/data_*/

**/.venv/*
# Audit test output files
/audit_*.json
/audit_*.jsonl

# Python cache
__pycache__/
**/__pycache__/

# Root-level test binaries (generated during development)
/test_io
/test_compile
/test_formatter
/test_writer
/test_arraylist
/user_auth
/root
/auth
test_writer
**/test_writer

# Generated files (but keep important config/test fixtures)
*.o
# Log files in root and common log directories
/*.log
test_logs/**/*.log
zig-out/**/*.log
# But keep important logs
!docs/**/*.log
tests/**/*.log

# Temporary text files (but keep documentation and test fixtures)
/*.txt
test_logs/**/*.txt
# But keep important txt files
!docs/**/*.txt
!fuzz/**/*.txt
!LICENSE.txt
!README.txt

# Temporary data files in common output directories
test_logs/**/*.jsonl
test_logs/**/*.csv
zig-out/**/*.jsonl
zig-out/**/*.csv
# But keep test fixtures and examples
!fuzz/**/*.jsonl
!fuzz/**/*.csv
!examples/**/*.jsonl
!examples/**/*.csv

# Temporary XML files (but keep config and test fixtures)
test_logs/**/*.xml
zig-out/**/*.xml
/combined_windows.xml
/windows_event_log.xml
# But keep important XML
!config/**/*.xml
!examples/**/*.xml
!specs/**/*.xml

# Build and cache directories
.direnv/
.zig-cache/
zig-cache/
zig-out/
/status_new*
test_logs/

# Docker development artifacts (large binary files)
docker/zig/*.tar.xz
docker/zig/*.tar.gz
docker/msquic/lib/*.so*
docker/msquic/lib/*.a
# Keep directory structure and .gitkeep files
!docker/*/.gitkeep

# Docker environment and secrets
.env
.env.local
.env.*.local
docker-compose.override.yml
!.env.docker-dev.example

# Modularization metrics (generated by scripts/modularization/generate_metrics.sh)
/metrics/

# Build folders
/bin/
ui/public/
ui/build/
ui/node_modules/
**/node_modules/

# Vendor (except quic submodule)
vendor/*
!vendor/quic/

# Editor directories and IDE configurations
# Keep workspace settings for VSCode/Cursor but ignore user-specific files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.cursor/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude settings
.claude/settings.local.json

# Keep devcontainer configuration
!.devcontainer/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Certificates and keys (security-sensitive)
*.crt
*.key
*.pem

# OS files
.DS_Store
Thumbs.db

# Client-specific build artifacts
clients/go/gql/zig-cache/
clients/go/gql/**/*.log
clients/**/*.log

# Rust client artifacts
clients/rust/target/
clients/rust/Cargo.lock
clients/**/target/
**/Cargo.lock
*.rs.bk

# Python client artifacts
clients/python/**/__pycache__/
clients/python/**/*.pyc
clients/python/**/*.pyo
clients/python/**/*.pyd
clients/python/.venv/
clients/python/venv/
clients/python/**/.pytest_cache/
clients/python/**/*.egg-info/
clients/python/dist/
clients/python/build/
clients/python/.eggs/

# Test harness artifacts
clients/test-harness/.venv/
clients/test-harness/venv/
clients/test-harness/**/__pycache__/
clients/test-harness/**/*.pyc
clients/test-harness/reports/
clients/test-harness/coverage/
clients/test-harness/.coverage
clients/test-harness/htmlcov/
clients/test-harness/.pytest_cache/

# Rust test runner artifacts
clients/test-harness/runners/rust_runner/target/
clients/test-harness/runners/rust_runner/Cargo.lock
clients/test-harness/runners/zig_runner

# Geodetestlab artifacts
geodetestlab/.venv/
geodetestlab/venv/
