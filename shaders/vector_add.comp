// Vector Addition Compute Shader
// Adds two vectors element-wise: C = A + B
//
// Usage:
//   - Binding 0: Input buffer A (float[])
//   - Binding 1: Input buffer B (float[])
//   - Binding 2: Output buffer C (float[])
//   - Push constant: n (number of elements)
//
// Dispatch: ceil(n / 256) workgroups

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer InputA {
    float data[];
} inputA;

layout(set = 0, binding = 1) readonly buffer InputB {
    float data[];
} inputB;

layout(set = 0, binding = 2) writeonly buffer Output {
    float data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

void main() {
    uint idx = gl_GlobalInvocationID.x;

    if (idx < pc.n) {
        output_buf.data[idx] = inputA.data[idx] + inputB.data[idx];
    }
}
