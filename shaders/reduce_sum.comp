// Parallel Reduction Sum Compute Shader
// Computes the sum of an array using parallel reduction
//
// Usage:
//   - Binding 0: Input buffer (float[])
//   - Binding 1: Output buffer (float[]) - partial sums per workgroup
//   - Push constant: n (number of elements)
//
// Dispatch: ceil(n / (256 * 2)) workgroups
// Note: Multiple passes may be needed for large arrays

#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Input {
    float data[];
} input_buf;

layout(set = 0, binding = 1) buffer Output {
    float data[];
} output_buf;

layout(push_constant) uniform PushConstants {
    uint n;
} pc;

// Shared memory for local reduction
shared float shared_data[256];

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint gid = gl_GlobalInvocationID.x;
    uint group_id = gl_WorkGroupID.x;

    // Load data into shared memory with coalesced access
    // Each thread loads two elements
    uint idx1 = gid * 2;
    uint idx2 = gid * 2 + 1;

    float sum = 0.0;
    if (idx1 < pc.n) {
        sum = input_buf.data[idx1];
    }
    if (idx2 < pc.n) {
        sum += input_buf.data[idx2];
    }
    shared_data[tid] = sum;

    barrier();

    // Parallel reduction in shared memory
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (tid < stride) {
            shared_data[tid] += shared_data[tid + stride];
        }
        barrier();
    }

    // Write result
    if (tid == 0) {
        output_buf.data[group_id] = shared_data[0];
    }
}
